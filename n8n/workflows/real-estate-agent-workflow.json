        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{ $json.recipient_wa_id }}\",\"type\":\"text\",\"text\":{\"body\":\"{{ $json.reply_text }}\"}}",
        "options": {
          "body": {

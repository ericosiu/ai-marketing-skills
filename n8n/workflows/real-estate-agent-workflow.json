    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst last = items[items.length - 1];\nconst out = last.json || {};\n\n// Copy schema fields forward for downstream nodes\nconst payload = {\n  message_text: out.message_text || \"\",\n  intent: out.intent || null,\n  category_m2: out.category_m2 || null,\n  reply_text: out.reply_text || \"\",\n  chat_id: out.chat_id || null,\n  recipient_wa_id: out.recipient_wa_id || null,\n  phone_number: out.phone_number || null,\n  source: out.source || \"unknown\",\n  inventory_text: out.inventory_text || \"\"\n};\n\nreturn [{ json: payload }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Normalize Output",
      "id": "normalizeOutput",
      "position": [1060, 300],

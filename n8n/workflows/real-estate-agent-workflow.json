    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramBot.apiKey }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={ \"chat_id\": $json[\"chat_id\"], \"text\": $json[\"reply_text\"] }",
        "options": {
          "body": {
            "json": "={ \"chat_id\": $json[\"chat_id\"], \"text\": $json[\"reply_text\"] }"
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "name": "Send Telegram Reply",
      "id": "sendReply",
      "position": [1160, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{ $credentials.whatsapp.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.whatsapp.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{ $json.recipient_wa_id }}\",\"type\":\"text\",\"text\":{\"body\":\"{{ $json.reply_text }}\"}}",
        "options": {
          "body": {
            "json": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{ $json.recipient_wa_id }}\",\"type\":\"text\",\"text\":{\"body\":\"{{ $json.reply_text }}\"}}"
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "name": "Send WhatsApp Reply",
      "id": "sendWhatsAppReply",
      "position": [1160, 440]
    },
    {
      "parameters": {
        "model": "gemini-2.0-mini",
        "options": {
          "systemMessage": "=You are a real estate assistant for flats for sale and rent.\n\nGOAL:\n- Classify customer intent as one of: `buy`, `rent`, `sell`, `unknown`.\n- If intent = `sell` and the customer has not given size yet, ask them to choose among: 86, 96, 92, 120 m².\n- If intent = `buy` or `rent`, optionally infer the closest size from the customer's text; if unclear, ask.\n- Normalize sizes to exactly 86, 96, 92, or 120.\n\nOUTPUT RULES:\n- You MUST answer in this JSON only:\n{\n  \"intent\": \"buy|rent|sell|unknown\",\n  \"category_m2\": 86|96|92|120|null,\n  \"missing\": [\"m2\"],\n  \"reply_text\": \"short friendly message\"\n}\n- Never invent flats. If flat details are missing, set missing=[\"m2\"] and include the question in reply_text.\n- Keep replies short, specific, and sales-friendly."
        },
        "userMessage": "={{ $json.message_text }}"
      },
      "type": "@n8n/n8n-nodes-langchain.lmChat",
      "typeVersion": 1,
      "name": "LLM Classifier (Gemini)",
      "id": "classifyIntent",
      "position": [420, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a real estate agent assistant. Use ONLY the provided inventory to answer.\n\nCustomer message:\n{{ $json.message_text }}\n\nClassified intent: {{ $json.intent }}\nPreferred size m²: {{ $json.category_m2 }}\n\nInventory:\n{{ $json.inventory_text || 'No inventory available.' }}\n\nReply in the same language as the customer. If no suitable flats, say none available now and ask if they want another size: 86, 96, 92, or 120 m².",
        "options": {
          "systemMessage": "You answer customers about flats for sale/rent. Always be concise and helpful."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "name": "Draft Reply",
      "id": "draftReply",
      "position": [1040, 300]
    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "=You are a helpful real estate assistant. Use the available tool to find matching flats. If the user wants to sell and has not chosen a size, ask for 86/96/92/120 m².\n\nCustomer text: {{ $json.message_text }}",
        "options": {
          "systemMessage": "You answer customers about flats for sale or rent. Be concise and helpful."
        }
      },
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.2,
      "position": [640, 300]

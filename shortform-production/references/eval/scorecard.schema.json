{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singlegrain.local/evals/shortform-editorial/v1/scorecard.schema.json",
  "title": "Short-Form Editorial Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval_version",
    "candidate",
    "profile",
    "platform",
    "promise",
    "authority_sequence",
    "hard_gates",
    "dimensions",
    "raw_weighted_score",
    "final_score",
    "band",
    "result",
    "top_strength",
    "primary_weakness",
    "recommended_changes"
  ],
  "properties": {
    "eval_version": {"const": "1.0.0"},
    "candidate": {"type": "string", "minLength": 1},
    "profile": {"enum": ["talking_head", "proof_driven", "motion_graphics"]},
    "platform": {"enum": ["instagram_reels", "tiktok", "youtube_shorts", "linkedin", "x", "other"]},
    "promise": {"type": "string", "minLength": 1},
    "authority_sequence": {"type": "string"},
    "hard_gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "weighted_points", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 5},
          "weighted_points": {"type": "number", "minimum": 0},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["timestamp", "observation"],
              "properties": {
                "timestamp": {"type": "string", "pattern": "^[0-9]{1,2}:[0-5][0-9](\\.[0-9]{1,3})?$"},
                "observation": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "raw_weighted_score": {"type": "number", "minimum": 0, "maximum": 100},
    "applied_caps": {"type": "array", "items": {"type": "string"}},
    "final_score": {"type": "number", "minimum": 0, "maximum": 100},
    "band": {"enum": ["reference_level", "strong", "pedestrian", "weak"]},
    "result": {"enum": ["pass", "fail"]},
    "top_strength": {"type": "string", "minLength": 1},
    "primary_weakness": {"type": "string", "minLength": 1},
    "recommended_changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "change", "expected_effect"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1, "maximum": 3},
          "change": {"type": "string", "minLength": 1},
          "expected_effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  }
}
